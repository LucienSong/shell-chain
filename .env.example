# Shell Chain Alpha Testnet Configuration
# Copy to .env and customize before deploying.
# Usage: cp .env.example .env

# --- Chain ---
CHAIN_ID=1337
BLOCK_TIME=2000
DB_BACKEND=rocksdb
LOG_FORMAT=json

# --- RPC Configuration ---
RPC_CORS=http://localhost:3000
RPC_API=eth,net,web3,shell
RPC_RATE_LIMIT=100

# --- Nginx ---
NGINX_PORT=443
DOMAIN=testnet.shell.xyz

# --- Grafana (if monitoring enabled) ---
# IMPORTANT: Change this to a strong, unique password before deploying.
GF_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
